#!/usr/bin/env bash
# yana-overlay-inner — mount helper run inside bwrap (not for direct use).
set -eu

# Own directory from BASH_SOURCE, never cwd: the outer `--ro-bind / /` keeps
# this bin/ directory visible at its real path inside the jail, so the sourced
# mount-phase library resolves to the same file this helper was exec'd at.
readonly INNER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

readonly EXIT_USAGE=64
readonly EXIT_REFUSE=65
readonly EXIT_MOUNT=67
readonly NEUTRAL_LOWER=/tmp/yana/lower
readonly NEUTRAL_LAYER=/tmp/yana/layer
readonly NEUTRAL_CURSOR=/tmp/yana/cursor
readonly NEUTRAL_STATE=/tmp/yana/state
readonly MOUNT_MARKER=.yana-overlay-mounted
readonly MOUNT_MARKER_CONTENT=mounted

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
	cat <<'EOF'
Usage: yana-overlay-inner WORKSPACE COMMAND [ARGS...]
       yana-overlay-inner --broad-root DIR [--extra-root DIR]...
                           [--cursor DIR] [--state-dir DIR]...
                           -- COMMAND [ARGS...]
       yana-overlay-inner --roots N ROOT... [--state-dir DIR]... -- COMMAND [ARGS...]

--state-dir names one backend state directory (backends.<name>.state_dirs)
to mount read-write at its real path AFTER the overlays, from the staging
bind yana-overlay made for it at /tmp/yana/state/<i>, i counting the
--state-dir arguments from 1 in the order they are given. Same reasoning,
and same failure mode, as the --cursor exception.

Every form runs the agent as the INVOKING USER, never as uid 0; see the
"Private mount namespace" comment below for what that costs and how this
helper pays it.

Internal mount-namespace helper invoked only by yana-overlay. The first form
is the single-root shape yana-overlay has always built when a turn declares
no broad root and no extra root; it is unchanged, byte for byte, and is the
shape tests/overlay_gate.sh drives this helper with directly.

The second form is the broad-root shape (PLAN-R1-capture.md WI-1, "one
broad-root overlay for fast, total capture"): ONE overlay is mounted at DIR
with -o volatile, and then -- ON TOP of that overlay -- the ~/.cursor
writable exception is mounted at its own real absolute path. Mounting it
here, after the overlay, rather than as an outer bwrap arg before it, is the
fix for the packet's own trap: a bind stacked before the overlay at a path
under DIR is invisible the instant the overlay covers DIR. A failure
mounting it is pre-agent, exactly like an overlay mount failure: fail
closed, no marker, capsh never reached.

Secret masking of any kind was RETIRED 2026-08-24 (ruling "Yana confines
writes, not reads", ship-issue tracker issue 2): a turn now reads exactly
what the operator's account can read, so this helper no longer accepts or
mounts anything of that shape. See bin/yana-overlay's own
"Secret mask — RETIRED" comment and the core contract doc.

The third form mounts one overlay per operator-declared write root (the
pre-broad-root shape, retained unchanged pending its own deletion). Root 1 is
always the opened workspace and keeps the neutral bind pair the single-root
form uses; root i uses /tmp/yana/r<i>/lower and /tmp/yana/r<i>/layer, which
yana-overlay binds inside bwrap's private /tmp.
EOF
	exit 0
fi

# ===================== Private mount namespace =====================
#
# bwrap runs this helper as the INVOKING USER (`--uid $real_uid`), never uid 0,
# so the agent it finally execs is the operator -- but at a non-zero uid the
# mount namespace bwrap made is owned by an ancestor user namespace and every
# mount into it is EPERM. This re-exec makes a namespace owned by the user
# namespace we do hold CAP_SYS_ADMIN in, copied from bwrap's mount table, so
# `--ro-bind / /`, the private /tmp and the neutral bind pairs all survive.
# `unshare` execs the target directly, so this adds no process.
if [[ -z "${YANA_OVERLAY_MOUNT_NS:-}" ]]; then
	export YANA_OVERLAY_MOUNT_NS=1
	exec unshare --mount -- "$0" "$@"
fi

BROAD_ROOT=""
CURSOR_DIR=""
ROOTS=()
EXEC_ALLOW=()
STATE_DIRS=()
CAPTURE_PLAN=""
OPEN_CAPTURE_BACKEND=""
# volatile applies to the broad-root shape only: teardown_work() chmod -R's before
# deleting and copes with it, a bare `rm -rf` does not, and the single-root and
# --roots shapes must stay byte-identical.
VOLATILE_OPT=""

source "$INNER_DIR/lib/yana-overlay/capture_plan.sh"

if [[ ${1:-} == "--capture-plan" ]]; then
	shift
	CAPTURE_PLAN=${1:?--capture-plan requires a file}
	shift
	[[ ${1:-} == "--backend" ]] || { echo "yana-overlay-inner: --capture-plan requires --backend" >&2; exit "$EXIT_USAGE"; }
	shift
	OPEN_CAPTURE_BACKEND=${1:?--backend requires a value}
	shift
	ROOTS=("$(capture_plan_field "$CAPTURE_PLAN" project_cwd)")
	while [[ $# -gt 0 && "$1" != "--" ]]; do
		case "$1" in
			--cursor)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --cursor requires a directory" >&2; exit "$EXIT_USAGE"; }
				CURSOR_DIR=$2
				shift 2
				;;
			--state-dir)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --state-dir requires a path" >&2; exit "$EXIT_USAGE"; }
				STATE_DIRS+=("$2")
				shift 2
				;;
			--exec-allow)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --exec-allow requires a path" >&2; exit "$EXIT_USAGE"; }
				EXEC_ALLOW+=("$2")
				shift 2
				;;
			*)
				echo "yana-overlay-inner: unknown capture-plan option '$1'" >&2
				exit "$EXIT_USAGE"
				;;
		esac
	done
	[[ ${1:-} == "--" ]] || { echo "yana-overlay-inner: expected -- after capture-plan options" >&2; exit "$EXIT_USAGE"; }
	shift
elif [[ ${1:-} == "--broad-root" ]]; then
	shift
	BROAD_ROOT=${1:?--broad-root requires a directory}
	VOLATILE_OPT=",volatile"
	shift
	ROOTS=("$BROAD_ROOT")
	while [[ $# -gt 0 && "$1" != "--" ]]; do
		case "$1" in
			--extra-root)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --extra-root requires a directory" >&2; exit "$EXIT_USAGE"; }
				ROOTS+=("$2")
				shift 2
				;;
			--cursor)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --cursor requires a directory" >&2; exit "$EXIT_USAGE"; }
				CURSOR_DIR=$2
				shift 2
				;;
			--state-dir)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --state-dir requires a path" >&2; exit "$EXIT_USAGE"; }
				STATE_DIRS+=("$2")
				shift 2
				;;
			--exec-allow)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --exec-allow requires a path" >&2; exit "$EXIT_USAGE"; }
				EXEC_ALLOW+=("$2")
				shift 2
				;;
			*)
				echo "yana-overlay-inner: unknown broad-root option '$1'" >&2
				exit "$EXIT_USAGE"
				;;
		esac
	done
	[[ ${1:-} == "--" ]] || { echo "yana-overlay-inner: expected -- after broad-root options" >&2; exit "$EXIT_USAGE"; }
	shift
elif [[ ${1:-} == "--roots" ]]; then
	shift
	count=${1:?--roots requires a count}
	[[ "$count" =~ ^[0-9]+$ ]] || { echo "yana-overlay-inner: --roots needs a number" >&2; exit "$EXIT_USAGE"; }
	shift
	for (( i = 0; i < count; i++ )); do
		ROOTS+=("${1:?--roots N requires N root directories}")
		shift
	done
	while [[ $# -gt 0 && "$1" != "--" ]]; do
		case "$1" in
			--state-dir)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --state-dir requires a path" >&2; exit "$EXIT_USAGE"; }
				STATE_DIRS+=("$2")
				shift 2
				;;
			--exec-allow)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --exec-allow requires a path" >&2; exit "$EXIT_USAGE"; }
				EXEC_ALLOW+=("$2")
				shift 2
				;;
			*)
				echo "yana-overlay-inner: unknown roots option '$1'" >&2
				exit "$EXIT_USAGE"
				;;
		esac
	done
	[[ ${1:-} == "--" ]] || { echo "yana-overlay-inner: expected -- after the root list" >&2; exit "$EXIT_USAGE"; }
	shift
else
	# The single-root form: WORKSPACE then the command. It is the shape
	# yana-overlay builds when a turn declares no broad root and no extra root.
	ROOTS=("${1:?WORKSPACE required}")
	shift
	while [[ $# -gt 0 && "$1" != "--" ]]; do
		case "$1" in
			--state-dir)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --state-dir requires a path" >&2; exit "$EXIT_USAGE"; }
				STATE_DIRS+=("$2")
				shift 2
				;;
			--exec-allow)
				[[ $# -ge 2 ]] || { echo "yana-overlay-inner: --exec-allow requires a path" >&2; exit "$EXIT_USAGE"; }
				EXEC_ALLOW+=("$2")
				shift 2
				;;
			*)
				# NOT an error and NOT a fallthrough: this form's `--` is
				# optional, so the first non-option token is the COMMAND, and
				# without this arm the loop spins on it forever.
				break
				;;
		esac
	done
	if [[ ${1:-} == "--" ]]; then
		shift
	fi
fi

LAYERS=()

source "$INNER_DIR/lib/yana-overlay/mount.sh"
source "$INNER_DIR/lib/yana-overlay/fuse.sh"

inner_run_agent_without_caps() {
	local capsh_path cap_now
	local -a cmd=( "$@" )
	capsh_path=$(command -v capsh) || {
		echo "yana-overlay-inner: capsh not found on PATH" >&2
		exit "$EXIT_REFUSE"
	}
	if (( ${#EXEC_ALLOW[@]} != 0 )); then
		echo "yana-overlay-inner: fuse-compat exec allowlist is not available" >&2
		exit "$EXIT_REFUSE"
	fi
	if [[ -n "${YANA_INLINE_EXEC_ALLOW_PATH:-}" ]]; then
		export PATH="$YANA_INLINE_EXEC_ALLOW_PATH"
	fi
	exec "$capsh_path" --drop=all --caps= -- -c '
cap_now=$(awk "/^CapEff:/ {print \$2}" /proc/self/status)
if [ "$cap_now" != 0000000000000000 ]; then
	echo open_capture_capabilities >&2
	exit 65
fi
exec "$@"
' capsh "${cmd[@]}"
}

if [[ -n "$CAPTURE_PLAN" && "$OPEN_CAPTURE_BACKEND" == fuse-compat ]]; then
	fuse_run inner_run_agent_without_caps "$@"
	exit $?
fi

mount_overlays
mount_cursor_exception
mount_state_dirs

# Markers are written only after the FULL set has mounted: yana-overlay reads
# them to tell a pre-agent mount failure from an agent that itself exited 67, so
# a partially mounted set must leave no marker at all.
for layer in "${LAYERS[@]}"; do
	touch "${layer}/${MOUNT_MARKER}"
	echo "$MOUNT_MARKER_CONTENT" >"${layer}/${MOUNT_MARKER}"
done

cmd=( "$@" )

# Resolve capsh against the real, unnarrowed PATH, BEFORE the narrowing below:
# it is this launcher's own capability-drop machinery, not a tool the agent chose.
capsh_path=$(command -v capsh) || {
	echo "yana-overlay-inner: capsh not found on PATH" >&2
	exit "$EXIT_REFUSE"
}

if (( ${#EXEC_ALLOW[@]} == 0 )); then
	inner_run_agent_without_caps "${cmd[@]}"
fi

python3_path=$(command -v python3) || {
	echo "yana-overlay-inner: python3 not found on PATH" >&2
	exit "$EXIT_REFUSE"
}

ldd_path=$(command -v ldd) || {
	echo "yana-overlay-inner: ldd not found on PATH (required to resolve the exec allowlist's library closure)" >&2
	exit "$EXIT_REFUSE"
}

if [[ -n "${YANA_INLINE_EXEC_ALLOW_PATH:-}" ]]; then
	export PATH="$YANA_INLINE_EXEC_ALLOW_PATH"
fi

# THE PROCESS THAT CALLS landlock_restrict_self(2) MUST BE THE PROCESS THAT EXECS
# THE CONFINED COMMAND, so `exec python3` HERE replaces this bash process rather
# than forking: that python3 sets up Landlock, restricts itself and execv()s into
# capsh, carrying the restriction through to the confined command. The command
# reaches it through a NUL-separated environment variable, never re-quoted into a
# shell string.
export YANA_INLINE_EXEC_CAPSH="$capsh_path"
export YANA_INLINE_EXEC_LDD="$ldd_path"
# \x1e cannot appear in a filesystem path or an ordinary command-line argument, so it is
# a safe field separator that survives both hops intact.
export YANA_INLINE_EXEC_CMD="$(printf '%s\x1e' "${cmd[@]}")"
exec "$python3_path" - "${EXEC_ALLOW[@]}" <<'PY'
import ctypes
import errno
import os
import subprocess
import sys

SYS_landlock_create_ruleset = 444
SYS_landlock_add_rule = 445
SYS_landlock_restrict_self = 446
LANDLOCK_CREATE_RULESET_VERSION = 1
LANDLOCK_RULE_PATH_BENEATH = 1
LANDLOCK_ACCESS_FS_EXECUTE = 1 << 0
LANDLOCK_ACCESS_FS_READ_FILE = 1 << 2
PR_SET_NO_NEW_PRIVS = 38
O_PATH = getattr(os, "O_PATH", 0o10000000)
O_CLOEXEC = os.O_CLOEXEC

class RulesetAttr(ctypes.Structure):
    _fields_ = [("handled_access_fs", ctypes.c_ulonglong)]

class PathBeneathAttr(ctypes.Structure):
    # _pack_ = 1: the kernel's struct landlock_path_beneath_attr is
    # __attribute__((packed)) (12 bytes: u64 + s32, no trailing padding).
    _pack_ = 1
    _fields_ = [("allowed_access", ctypes.c_ulonglong), ("parent_fd", ctypes.c_int)]

libc = ctypes.CDLL(None, use_errno=True)
syscall = libc.syscall
syscall.restype = ctypes.c_long

def die(msg):
    print("yana-overlay-inner: " + msg, file=sys.stderr)
    sys.exit(65)

def refuse_exec(argv0, exc):
    # THE STRUCTURED REFUSAL LINE: lua/yana/agent/agent.lua parses it FIRST for
    # an exact argv0 and the real errno, and only falls back to free-text stderr
    # matching when it is absent.
    name = errno.errorcode.get(exc.errno, str(exc.errno))
    print("yana-exec-refused argv0=%s errno=%s" % (argv0, name), file=sys.stderr)

# Resolved by bash against the real, unnarrowed PATH: by the time this process
# runs PATH is the allowlist's own bindir, which holds no `ldd`.
LDD_PATH = os.environ.get("YANA_INLINE_EXEC_LDD", "")
if not LDD_PATH:
    die("ldd path not provided (YANA_INLINE_EXEC_LDD unset)")

def die_closure(entry, detail):
    # FAIL CLOSED, NEVER A SILENT HANG: an unresolvable closure is refused by
    # name through the SAME structured line a real denied exec prints. The
    # errno=ENOENT is synthetic but names the right class, a missing .so.
    print(
        "yana-overlay-inner: cannot resolve library closure for %s: %s" % (entry, detail),
        file=sys.stderr,
    )
    print("yana-exec-refused argv0=%s errno=ENOENT" % entry, file=sys.stderr)
    sys.exit(65)

def resolve_closure(entry):
    # The extra absolute paths -- ELF interpreter plus every shared object `entry`
    # maps PROT_EXEC -- that ALSO need an EXECUTE rule before `entry`'s own
    # execve(2) can succeed: EXECUTE on the file alone still fails EACCES here.
    # `ldd` rather than parsing PT_INTERP/DT_NEEDED, so the names come from the
    # same dynamic linker the kernel's loader uses at exec time.
    try:
        proc = subprocess.run(
            [LDD_PATH, entry],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
    except OSError as exc:
        die_closure(entry, "ldd could not be run (errno=%s)" % (exc.errno or "?"))
    output = proc.stdout or ""
    low = output.lower()
    if "not a dynamic executable" in low or "statically linked" in low:
        # A statically linked binary, or a non-ELF script, needs nothing extra:
        # no interpreter and no .so to resolve. A script's own INTERPRETER is a
        # separate exec target the operator must list itself.
        return set()
    extra = set()
    missing = []
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        if "=>" in line:
            left, right = line.split("=>", 1)
            right = right.strip()
            if right.startswith("not found"):
                missing.append(left.strip())
                continue
            tokens = right.split()
            token = tokens[0] if tokens else ""
        else:
            tokens = line.split()
            token = tokens[0] if tokens else ""
        if token.startswith("/"):
            extra.add(token)
    if missing:
        die_closure(entry, "shared object(s) not found: %s" % ", ".join(sorted(missing)))
    if proc.returncode != 0 and not extra:
        die_closure(
            entry,
            "ldd exited %d resolving library closure: %s" % (proc.returncode, output.strip()),
        )
    return extra

# Read BEFORE Landlock setup because capsh_path is needed below to resolve its
# OWN library closure: capsh is launcher machinery, not a tool the agent chose,
# so its exec must stay grantable even when the allowlist never names it.
capsh_path = os.environ.get("YANA_INLINE_EXEC_CAPSH", "")
if not capsh_path:
    die("capsh path not provided (YANA_INLINE_EXEC_CAPSH unset)")
raw_cmd = os.environ.get("YANA_INLINE_EXEC_CMD", "")
cmd_argv = raw_cmd.split("\x1e")
if cmd_argv and cmd_argv[-1] == "":
    cmd_argv.pop()
if not cmd_argv:
    die("no command to exec (YANA_INLINE_EXEC_CMD empty)")

abi = syscall(SYS_landlock_create_ruleset, 0, 0, LANDLOCK_CREATE_RULESET_VERSION)
if abi < 1:
    e = ctypes.get_errno()
    die("Landlock unavailable for inline_exec_allowlist (errno=%s)" % (e or errno.ENOSYS))

# EXECUTE ONLY: LANDLOCK_ACCESS_FS_READ_FILE must NOT be added here. Every bit
# named in handled_access_fs is deny-by-default process-wide, not just for the
# allowlisted paths, so handling READ_FILE gates every plain open() the confined
# process makes -- including python3's own stdlib imports -- and kills any
# allowlisted program that reads its data files. With the closure granted,
# EXECUTE alone suffices; what may be READ is bwrap's mount table's boundary.
HANDLED_ACCESS_FS = LANDLOCK_ACCESS_FS_EXECUTE

ruleset_attr = RulesetAttr(HANDLED_ACCESS_FS)
ruleset_fd = syscall(
    SYS_landlock_create_ruleset,
    ctypes.byref(ruleset_attr),
    ctypes.sizeof(ruleset_attr),
    0,
)
if ruleset_fd < 0:
    die("Landlock ruleset creation failed (errno=%s)" % ctypes.get_errno())

# Every FILE this ruleset grants EXECUTE to: each listed entry plus capsh, and
# for every dynamically linked one its closure. FILES, never a directory -- a
# rule over /lib would grant execute to everything beneath it, including an
# unlisted binary sharing libc with an allowlisted one.
listed = list(sys.argv[1:]) + [capsh_path]
allow_targets = set(listed)
for entry in listed:
    allow_targets |= resolve_closure(entry)

for path in sorted(allow_targets):
    try:
        fd = os.open(path, O_PATH | O_CLOEXEC)
    except OSError as exc:
        die("Landlock allowlist path cannot be opened: %s (errno=%s)" % (path, exc.errno))
    try:
        rule = PathBeneathAttr(HANDLED_ACCESS_FS, fd)
        rc = syscall(
            SYS_landlock_add_rule,
            ruleset_fd,
            LANDLOCK_RULE_PATH_BENEATH,
            ctypes.byref(rule),
            0,
        )
        if rc != 0:
            die("Landlock rule failed for %s (errno=%s)" % (path, ctypes.get_errno()))
    finally:
        os.close(fd)

if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
    die("Landlock no_new_privs setup failed (errno=%s)" % ctypes.get_errno())
if syscall(SYS_landlock_restrict_self, ruleset_fd, 0) != 0:
    die("Landlock restrict_self failed (errno=%s)" % ctypes.get_errno())
os.close(ruleset_fd)

# capsh's `--` hands its remaining arguments to a shell; `-c 'exec "$@"' capsh
# <cmd...>` is the argv-safe idiom for crossing that boundary, so cmd_argv
# arrives verbatim with no argument's own bytes re-parsed.
argv = [capsh_path, "--drop=all", "--caps=", "--", "-c", 'exec "$@"', "capsh"] + cmd_argv
try:
    os.execv(capsh_path, argv)
except OSError as exc:
    refuse_exec(capsh_path, exc)
    sys.exit(65)
PY
