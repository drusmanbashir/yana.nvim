#!/usr/bin/env python3
#AI
"""yana-ollama-agent — local Ollama backend for Yana's model zoo.

Speaks the argv subset `lua/yana/agent.lua` build_cmd() produces for a
cursor-protocol backend:

  yana-ollama-agent -p --output-format stream-json [--stream-partial-output]
                    [--force] [--model NAME] [--mode ask] PROMPT
  yana-ollama-agent --list-models

Talks to the Ollama HTTP API (OLLAMA_HOST, default http://127.0.0.1:11434).
Emits cursor-shaped NDJSON on stdout so Yana's existing stream reader works
without a new stream_protocol. File tools write the workspace cwd (the jail
overlay when Yana confines the turn).

Confinement note (modes.md server-mode rule): the *shim process* is what
Yana's jail wraps. The Ollama daemon is a separate local service outside
that wrap — the same shape as any network tool. Edits still land only where
the shim writes (cwd / overlay).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")
DEFAULT_MODEL = os.environ.get("YANA_OLLAMA_MODEL", "qwen2.5-coder:7b")


def emit(obj: dict) -> None:
    obj.setdefault("timestamp_ms", int(time.time() * 1000))
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def http_json(method: str, path: str, body: dict | None = None, timeout: float = 600.0) -> dict:
    data = None if body is None else json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        HOST + path,
        data=data,
        method=method,
        headers={"Content-Type": "application/json"} if data else {},
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def list_models() -> int:
    try:
        data = http_json("GET", "/api/tags", timeout=30.0)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
        print(f"yana-ollama-agent: cannot reach ollama at {HOST}: {exc}", file=sys.stderr)
        return 1
    print("Available models\n")
    print("auto - let ollama / Yana default choose")
    for m in data.get("models") or []:
        name = m.get("name") or m.get("model") or ""
        if not name:
            continue
        print(f"{name} - {name}")
    return 0


TOOLS = [
    {
        "type": "function",
        "function": {
            "name": "Write",
            "description": "Create or overwrite a file with the given contents (workspace-relative path).",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "contents": {"type": "string"},
                },
                "required": ["path", "contents"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "StrReplace",
            "description": "Replace one exact occurrence of old_string with new_string in a file.",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "old_string": {"type": "string"},
                    "new_string": {"type": "string"},
                },
                "required": ["path", "old_string", "new_string"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "Read",
            "description": "Read a UTF-8 text file from the workspace.",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
]


def abs_in_cwd(rel: str) -> Path:
    p = Path(rel)
    if p.is_absolute():
        return p
    return (Path.cwd() / p).resolve()


def synthesize_diff(before: str, after: str, path: str) -> str:
    if before == after:
        return ""
    # Minimal unified-ish header; Yana also synthesizes from before/after.
    return f"--- a/{path}\n+++ b/{path}\n"


def emit_write(call_id: str, path: str, before: str | None, after: str) -> None:
    abs_path = str(abs_in_cwd(path))
    success = {
        "path": abs_path,
        "afterFullFileContent": after,
        "linesAdded": after.count("\n") - (before or "").count("\n") if before is not None else after.count("\n") + 1,
        "linesRemoved": 0 if before is None else max(0, before.count("\n") - after.count("\n")),
        "diffString": synthesize_diff(before or "", after, path),
        "message": "created" if before is None else "updated",
    }
    if before is not None:
        success["beforeFullFileContent"] = before
    tool_key = "editToolCall" if before is not None else "editToolCall"
    # create = no beforeFullFileContent (product classify_kind)
    if before is None:
        success.pop("beforeFullFileContent", None)
        # keep editToolCall; product classifies create from missing before
    args = {"path": abs_path, "streamContent": after}
    emit(
        {
            "type": "tool_call",
            "subtype": "completed",
            "call_id": call_id,
            "tool_call": {tool_key: {"args": args, "result": {"success": success}}},
            "model_call_id": "ollama-1",
            "session_id": "ollama-sess",
        }
    )


def apply_write(path: str, contents: str) -> tuple[str | None, str]:
    target = abs_in_cwd(path)
    before = target.read_text(encoding="utf-8") if target.exists() else None
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(contents, encoding="utf-8")
    return before, contents


def apply_str_replace(path: str, old: str, new: str) -> tuple[str, str]:
    target = abs_in_cwd(path)
    before = target.read_text(encoding="utf-8")
    if old not in before:
        raise ValueError(f"old_string not found in {path}")
    after = before.replace(old, new, 1)
    target.write_text(after, encoding="utf-8")
    return before, after


def parse_tool_calls(message: dict) -> list[dict]:
    """Ollama may return proper tool_calls or JSON text in content."""
    out = []
    for tc in message.get("tool_calls") or []:
        fn = tc.get("function") or {}
        name = fn.get("name")
        args = fn.get("arguments")
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except json.JSONDecodeError:
                args = {}
        if name:
            out.append({"name": name, "arguments": args or {}})
    content = (message.get("content") or "").strip()
    if not out and content.startswith("{") and '"name"' in content:
        try:
            blob = json.loads(content)
            if "name" in blob and "arguments" in blob:
                out.append({"name": blob["name"], "arguments": blob["arguments"]})
        except json.JSONDecodeError:
            pass
    return out


def run_turn(prompt: str, model: str, ask_only: bool) -> int:
    emit(
        {
            "type": "system",
            "subtype": "init",
            "model": model,
            "cwd": str(Path.cwd()),
            "session_id": "ollama-sess",
        }
    )
    system = (
        "You are a coding agent inside Neovim (Yana). "
        "Use the Write / StrReplace / Read tools to edit workspace files. "
        "Prefer StrReplace for small edits. Paths are workspace-relative. "
        "Do not invent files you have not Read when replacing."
    )
    if ask_only:
        system = "You are a coding assistant. Answer in plain text. Do not call tools."
    messages = [
        {"role": "system", "content": system},
        {"role": "user", "content": prompt},
    ]
    n_calls = 0
    files_changed: set[str] = set()
    final_text = ""
    for _round in range(8):
        body = {
            "model": model,
            "messages": messages,
            "stream": False,
        }
        if not ask_only:
            body["tools"] = TOOLS
        try:
            data = http_json("POST", "/api/chat", body, timeout=600.0)
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            emit(
                {
                    "type": "result",
                    "subtype": "error",
                    "error": str(exc),
                    "tool_calls": n_calls,
                    "files_changed": len(files_changed),
                    "result": final_text,
                    "session_id": "ollama-sess",
                }
            )
            print(f"yana-ollama-agent: chat failed: {exc}", file=sys.stderr)
            return 1
        msg = data.get("message") or {}
        content = msg.get("content") or ""
        if content:
            final_text = content
            emit(
                {
                    "type": "assistant",
                    "message": {"content": [{"type": "text", "text": content}]},
                    "model_call_id": "ollama-1",
                    "session_id": "ollama-sess",
                }
            )
        calls = [] if ask_only else parse_tool_calls(msg)
        if not calls:
            break
        messages.append(msg)
        for call in calls:
            n_calls += 1
            cid = f"ollama-t{n_calls}"
            name = call["name"]
            args = call.get("arguments") or {}
            try:
                if name == "Read":
                    text = abs_in_cwd(args["path"]).read_text(encoding="utf-8")
                    result = {"ok": True, "content": text[:200000]}
                elif name == "Write":
                    before, after = apply_write(args["path"], args.get("contents", ""))
                    emit_write(cid, args["path"], before, after)
                    files_changed.add(str(abs_in_cwd(args["path"])))
                    result = {"ok": True}
                elif name == "StrReplace":
                    before, after = apply_str_replace(
                        args["path"], args["old_string"], args["new_string"]
                    )
                    emit_write(cid, args["path"], before, after)
                    files_changed.add(str(abs_in_cwd(args["path"])))
                    result = {"ok": True}
                else:
                    result = {"ok": False, "error": f"unknown tool {name}"}
            except Exception as exc:  # noqa: BLE001 — tool errors go back to the model
                result = {"ok": False, "error": str(exc)}
            messages.append(
                {
                    "role": "tool",
                    "content": json.dumps(result),
                }
            )
    # Honest result envelope (row-84 / ollama honesty gate): never invent a
    # placeholder "ok". Agentic turns with zero tool calls are not success —
    # that was the operator's silent do-nothing turn. Ask mode may succeed
    # with prose alone.
    if ask_only or n_calls > 0:
        subtype = "success"
    else:
        subtype = "no_tools"
    emit(
        {
            "type": "result",
            "subtype": subtype,
            "result": final_text,
            "tool_calls": n_calls,
            "files_changed": len(files_changed),
            "session_id": "ollama-sess",
        }
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if os.environ.get("YANA_ARGV_LOG"):
        Path(os.environ["YANA_ARGV_LOG"]).write_text("\n".join(argv) + "\n")
    if "--list-models" in argv:
        return list_models()
    # Drop flags Yana always places; keep --model and prompt.
    model = DEFAULT_MODEL
    ask_only = False
    positional: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--force", "--stream-partial-output"):
            i += 1
            continue
        if a == "--output-format":
            i += 2
            continue
        if a == "--model" and i + 1 < len(argv):
            model = argv[i + 1]
            i += 2
            continue
        if a == "--mode" and i + 1 < len(argv):
            ask_only = argv[i + 1] == "ask"
            i += 2
            continue
        if a == "--resume":
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        positional.append(a)
        i += 1
    prompt = positional[-1] if positional else ""
    if not prompt:
        print("yana-ollama-agent: missing prompt", file=sys.stderr)
        return 2
    return run_turn(prompt, model, ask_only)


if __name__ == "__main__":
    raise SystemExit(main())
