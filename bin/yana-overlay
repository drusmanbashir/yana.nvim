#!/usr/bin/env bash
# yana-overlay — kernel overlayfs workspace confinement.
set -euo pipefail

readonly EXIT_USAGE=64
readonly EXIT_REFUSE=65
readonly EXIT_NO_SANDBOX=66
readonly EXIT_MOUNT=67

readonly NEUTRAL_LOWER=/tmp/yana/lower
readonly NEUTRAL_LAYER=/tmp/yana/layer
# Staging binds inside bwrap's private /tmp for the two things that must be mounted onto
# their REAL paths after the overlay covers them (the ~/.cursor exception and the
# backend state dirs). /tmp is bwrap's own tmpfs and can never be under a mounted root,
# so a bind made here still names the host directory, and -- because it is a plain
# `--bind`, not `--ro-bind` -- it is read-write without a remount.
readonly NEUTRAL_CURSOR=/tmp/yana/cursor
readonly NEUTRAL_STATE=/tmp/yana/state
readonly MOUNT_MARKER=.yana-overlay-mounted
readonly MOUNT_MARKER_CONTENT=mounted

# The turn's liveness evidence lives in the host cgroup v2 hierarchy, not in
# anything the confined agent can write. See "Liveness evidence" below.
readonly CGROUP_MOUNT=/sys/fs/cgroup
readonly CGROUP_SLICE_NAME=yana.slice

#
# A turn reads exactly what the operator's account can read, the same as running
# cursor-agent directly outside Yana — the operator accepted in writing that a turn can
# then read ~/.ssh/id_rsa.
#
# Reason: a fixed list can only hide what someone thought to name — the capsule-contract
# module doc already said a plain `--ro-bind / /` plus a blacklist "cannot enforce
# basename masks or identity aliases without a whole-host scan".
#
# WRITE confinement below (the overlay, the claim, the review boundary) is
# unchanged by this — only the READ mask is gone.

declare -A LAUNCH_PATH_IDENTITY=()

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INNER="${YANA_OVERLAY_INNER:-$DIR/yana-overlay-inner}"
BWRAP="${YANA_OVERLAY_BWRAP:-${YANA_SANDBOX_BWRAP:-bwrap}}"

WORKSPACE=""
UPPER=""
WORK=""
STATE_ROOT="${YANA_STATE_ROOT:-${XDG_STATE_HOME:+$XDG_STATE_HOME/yana}}"
STATE_ROOT="${STATE_ROOT:-${HOME:-/tmp}/.local/state/yana}"
SESSION_ID=""
AUTO_SESSION=0
TURN_ID=""
MODE=""
ANSWER_OUT=""
TOUCHED_FILES=()
# Operator-declared write roots beyond the opened workspace (the external-roots
# contract). One parallel entry per extra root, in the canonical-path order the
# caller passed them; index 0 here is root 2 of the turn, because the primary
# workspace is always root 1 and is never listed. Empty in every single-root
# launch, which is what keeps that launch byte-identical to the one this file
# has always made.
EXTRA_ROOTS=()
EXTRA_UPPERS=()
EXTRA_WORKS=()
EXTRA_LAYER_ROOTS=()
EXEC_ALLOW=()
STATE_DIRS=()
BROAD_ROOT=""
# Every path of the confined tree that a mask, the writable-host exception or
# TMPDIR must not swallow: the workspace, its layer root, then each extra root
# and its layer root. Built once by validate_paths. Deliberately does NOT
# include BROAD_ROOT: an exception living inside the broad root (the ordinary case,
# e.g. $HOME/.ssh under a broad root of $HOME) is the point, not a conflict.
PROTECTED_PATHS=()
TURN_CGROUP=""
TURN_CGROUP_PARENT=""
TURN_CGROUP_TAG=""
CMD=()
FORCE_REASON=""
CURSOR_DIR=""
OPERATOR_HOME=""


source "$DIR/lib/yana-overlay/paths.sh"
source "$DIR/lib/yana-overlay/yanad.sh"
source "$DIR/lib/yana-overlay/cgroup.sh"


# --unshare-pid is the read half of the boundary (the isolation contract,
# "Read boundary"). Without it the `--proc /proc` mount still describes the host
# PID namespace, and the agent enumerates every host process — command lines,
# status, open file descriptors. It pairs with the `--proc /proc` above and is
# meaningless without it.
#
# --as-pid-1 is deliberately NOT passed. bubblewrap's own reaper takes PID 1 and
# the agent runs as PID 2, so orphaned `npx` and MCP children are reaped by the
# reaper. Handing PID 1 to a Node process that performs no init duties would
# leave them as zombies.
run_overlay() {
	# `mount_root` is the single point that names what gets mounted, on purpose: reverting
	# WI-1 to a narrow-root mount is then a one-line change (mount_root=$WORKSPACE),
	# exactly the mutation tests/overlay_broadroot_gate.sh drives.
	if [[ -n "$BROAD_ROOT" ]]; then
		local mount_root=$BROAD_ROOT
		local -a inner_args=("--broad-root" "$mount_root")
		local -a extra_binds=()
		local d i idx
		for (( i = 0; i < ${#EXTRA_ROOTS[@]}; i++ )); do
			idx=$(( i + 2 ))
			extra_binds+=(--ro-bind "${EXTRA_ROOTS[$i]}" "/tmp/yana/r$idx/lower")
			extra_binds+=(--bind "${EXTRA_LAYER_ROOTS[$i]}" "/tmp/yana/r$idx/layer")
			extra_binds+=(--dir "${EXTRA_ROOTS[$i]}")
			inner_args+=("--extra-root" "${EXTRA_ROOTS[$i]}")
		done
		# Capture real uid/gid BEFORE entering the outer bwrap user namespace
		local real_uid real_gid
		real_uid=$(id -u)
		real_gid=$(id -g)
		inner_args+=("--cursor" "$CURSOR_DIR")
		for d in ${STATE_DIRS[@]+"${STATE_DIRS[@]}"}; do
			inner_args+=("--state-dir" "$d")
		done
		for d in ${EXEC_ALLOW[@]+"${EXEC_ALLOW[@]}"}; do
			inner_args+=("--exec-allow" "$d")
		done
		inner_args+=("--")

		set +e
		# Build bwrap argv with state_dirs binds
		local -a bwrap_args=(
			--die-with-parent
			--new-session
			--ro-bind / /
			--tmpfs /tmp
			--ro-bind "$mount_root" "$NEUTRAL_LOWER"
			--bind "$LAYER_ROOT" "$NEUTRAL_LAYER"
			--bind "$CURSOR_DIR" "$NEUTRAL_CURSOR"
			--dir "$mount_root"
		)
		if (( ${#extra_binds[@]} > 0 )); then
			bwrap_args+=("${extra_binds[@]}")
		fi
		# The per-backend writable state directories, staged under bwrap's own /tmp tmpfs
		# rather than bound straight onto their real paths. yana-overlay-inner mounts them
		# from there onto their real paths AFTER the overlay(s), because a bind stacked HERE
		# at a path under a mounted root is invisible the instant the overlay covers that root
		# -- the same trap the ~/.cursor exception was moved inside for. Index i must match
		# the order the --state-dir arguments are passed in.
		local state_idx=0 state_dir state_base
		for state_dir in ${STATE_DIRS[@]+"${STATE_DIRS[@]}"}; do
			state_idx=$(( state_idx + 1 ))
			# Created here, on the HOST, as the invoking user -- before any
			# namespace exists. A vendor's first run has no state directory yet,
			# and bwrap refuses to bind a source that is not there.
			#
			# Strip one leading dot from the basename; a dot in what remains means an extension,
			# so a file.
			if [[ ! -e "$state_dir" ]]; then
				state_base=${state_dir##*/}
				if [[ "${state_base#.}" == *.* ]]; then
					mkdir -p "${state_dir%/*}" 2>/dev/null || true
					: >"$state_dir" 2>/dev/null || true
				else
					mkdir -p "$state_dir" 2>/dev/null || true
				fi
			fi
			[[ -e "$state_dir" ]] || continue
			bwrap_args+=(--bind "$state_dir" "$NEUTRAL_STATE/$state_idx")
		done
		bwrap_args+=(
			--dev /dev
			--proc /proc
			--unshare-uts
			--unshare-user
			--unshare-pid
			# THE AGENT RUNS AS THE INVOKING USER. Not uid 0, and no path from inside the sandbox
			# reaches uid 0 at all: the user namespace bwrap builds here maps exactly ONE uid,
			# the operator's own, so root does not exist inside it to be reached.
			#
			# CAP_SYS_ADMIN below is still granted, and is still only ever held by
			# bin/yana-overlay-inner's mount phase -- its own `capsh --drop=all --caps=` drops
			# every capability before the agent is exec'd. See its "Private mount namespace"
			# comment for the measurements.
			--uid "$real_uid"
			--gid "$real_gid"
			--cap-add CAP_SYS_ADMIN
			--cap-add CAP_DAC_OVERRIDE
			--cap-add CAP_SETPCAP
			--
			"$INNER"
		)
		"$BWRAP" "${bwrap_args[@]}" "${inner_args[@]}" "${CMD[@]}"
		local rc=$?
		set -e
		return "$rc"
	fi

	# Everything below is UNCHANGED, byte for byte, from before --broad-root existed: one
	# overlay per declared root, each at its own real absolute path, each from its own
	# neutral bind pair inside bwrap's private /tmp. The primary keeps /tmp/yana/lower and
	# /tmp/yana/layer, so a single-root launch (no --broad-root, no --extra-root) builds
	# exactly the argv it always did; root i (2-based, the workspace being root 1) uses
	# /tmp/yana/r<i>/lower and /tmp/yana/r<i>/layer. The ~/.cursor exception stays an outer
	local -a extra_binds=()
	local -a inner_args=("$WORKSPACE")
	local i idx
	# Capture real uid/gid BEFORE entering the outer bwrap user namespace
	local real_uid real_gid
	real_uid=$(id -u)
	real_gid=$(id -g)
	if (( ${#EXTRA_ROOTS[@]} > 0 )); then
		inner_args=("--roots" "$(( ${#EXTRA_ROOTS[@]} + 1 ))" "$WORKSPACE")
		for (( i = 0; i < ${#EXTRA_ROOTS[@]}; i++ )); do
			idx=$(( i + 2 ))
			extra_binds+=(--ro-bind "${EXTRA_ROOTS[$i]}" "/tmp/yana/r$idx/lower")
			extra_binds+=(--bind "${EXTRA_LAYER_ROOTS[$i]}" "/tmp/yana/r$idx/layer")
			extra_binds+=(--dir "${EXTRA_ROOTS[$i]}")
			inner_args+=("${EXTRA_ROOTS[$i]}")
		done
	fi
	for i in ${STATE_DIRS[@]+"${STATE_DIRS[@]}"}; do
		inner_args+=("--state-dir" "$i")
	done
	for i in ${EXEC_ALLOW[@]+"${EXEC_ALLOW[@]}"}; do
		inner_args+=("--exec-allow" "$i")
	done
	if (( ${#EXTRA_ROOTS[@]} > 0 || ${#STATE_DIRS[@]} > 0 || ${#EXEC_ALLOW[@]} > 0 )); then
		inner_args+=("--")
	fi
	set +e
	# Build bwrap argv with state_dirs binds
	local -a bwrap_args=(
		--die-with-parent
		--new-session
		--ro-bind / /
		--bind "$CURSOR_DIR" "$CURSOR_DIR"
		--tmpfs /tmp
		--ro-bind "$WORKSPACE" "$NEUTRAL_LOWER"
		--bind "$LAYER_ROOT" "$NEUTRAL_LAYER"
		--dir "$WORKSPACE"
	)
	# Add extra_binds if any
	if (( ${#extra_binds[@]} > 0 )); then
		bwrap_args+=("${extra_binds[@]}")
	fi
	# The per-backend writable state directories, staged under bwrap's own /tmp tmpfs
	# rather than bound straight onto their real paths. yana-overlay-inner mounts them from
	# there onto their real paths AFTER the overlay(s), because a bind stacked HERE at a
	# path under a mounted root is invisible the instant the overlay covers that root --
	# the same trap the ~/.cursor exception was moved inside for. Index i must match the
	# order the --state-dir arguments are passed in.
	local state_idx=0 state_dir state_base
	for state_dir in ${STATE_DIRS[@]+"${STATE_DIRS[@]}"}; do
		state_idx=$(( state_idx + 1 ))
		# Created here, on the HOST, as the invoking user -- before any
		# namespace exists. A vendor's first run has no state directory yet,
		# and bwrap refuses to bind a source that is not there.
		#
		# Strip one leading dot from the basename; a dot in what remains means an extension,
		# so a file.
		if [[ ! -e "$state_dir" ]]; then
			state_base=${state_dir##*/}
			if [[ "${state_base#.}" == *.* ]]; then
				mkdir -p "${state_dir%/*}" 2>/dev/null || true
				: >"$state_dir" 2>/dev/null || true
			else
				mkdir -p "$state_dir" 2>/dev/null || true
			fi
		fi
		[[ -e "$state_dir" ]] || continue
		bwrap_args+=(--bind "$state_dir" "$NEUTRAL_STATE/$state_idx")
	done
	bwrap_args+=(
		--dev /dev
		--proc /proc
		--unshare-uts
		--unshare-user
		--unshare-pid
		# THE AGENT RUNS AS THE INVOKING USER. Not uid 0, and no path from inside the sandbox
		# reaches uid 0 at all: the user namespace bwrap builds here maps exactly ONE uid, the
		# operator's own, so root does not exist inside it to be reached.
		#
		# CAP_SYS_ADMIN below is still granted, and is still only ever held by
		# bin/yana-overlay-inner's mount phase -- its own `capsh --drop=all --caps=` drops
		# every capability before the agent is exec'd. See its "Private mount namespace"
		# comment for the measurements.
		--uid "$real_uid"
		--gid "$real_gid"
		--cap-add CAP_SYS_ADMIN
		--cap-add CAP_DAC_OVERRIDE
		--cap-add CAP_SETPCAP
		--
		"$INNER"
	)
	"$BWRAP" "${bwrap_args[@]}" "${inner_args[@]}" "${CMD[@]}"
	local rc=$?
	set -e
	return "$rc"
}

# EVERY root's marker, because the inner helper writes them only once every
# mount has succeeded. A partial mount must read as a failure here, or the
# pre-agent classification below would decline to release the claims for a turn
# that never started.
mount_succeeded() {
	local layer
	for layer in "$LAYER_ROOT" ${EXTRA_LAYER_ROOTS[@]+"${EXTRA_LAYER_ROOTS[@]}"}; do
		[[ -n "$layer" ]] || continue
		[[ -f "$layer/$MOUNT_MARKER" ]] || return 1
		grep -qx "$MOUNT_MARKER_CONTENT" "$layer/$MOUNT_MARKER" 2>/dev/null || return 1
	done
	return 0
}

parse_run_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--workspace)
				[[ $# -ge 2 ]] || die_usage "--workspace requires a directory"
				WORKSPACE=$2
				shift 2
				;;
			--upper)
				[[ $# -ge 2 ]] || die_usage "--upper requires a directory"
				UPPER=$2
				shift 2
				;;
			--work)
				[[ $# -ge 2 ]] || die_usage "--work requires a directory"
				WORK=$2
				shift 2
				;;
			--session)
				[[ $# -ge 2 ]] || die_usage "--session requires an id"
				SESSION_ID=$2
				shift 2
				;;
			--session-auto)
				AUTO_SESSION=1
				shift
				;;
			--turn)
				[[ $# -ge 2 ]] || die_usage "--turn requires an id"
				TURN_ID=$2
				shift 2
				;;
			--mode)
				[[ $# -ge 2 ]] || die_usage "--mode requires a value"
				MODE=$2
				shift 2
				;;
			--answer-out)
				[[ $# -ge 2 ]] || die_usage "--answer-out requires a file path"
				ANSWER_OUT=$2
				shift 2
				;;
			--touched)
				[[ $# -ge 2 ]] || die_usage "--touched requires an absolute path"
				TOUCHED_FILES+=("$2")
				shift 2
				;;
			--broad-root)
				[[ $# -ge 2 ]] || die_usage "--broad-root requires a directory"
				BROAD_ROOT=$2
				shift 2
				;;
			--exec-allow)
				[[ $# -ge 2 ]] || die_usage "--exec-allow requires a path"
				EXEC_ALLOW+=("$2")
				shift 2
				;;
			--state-dir)
				[[ $# -ge 2 ]] || die_usage "--state-dir requires a path"
				STATE_DIRS+=("$2")
				shift 2
				;;
			# One operator-declared write root per group. --extra-root opens the
			# group; the three that follow attach to it. Placeholders keep the
			# four arrays index-aligned so a missing member of a group is a
			# usage error naming the root rather than a silent off-by-one.
			--extra-root)
				[[ $# -ge 2 ]] || die_usage "--extra-root requires a directory"
				EXTRA_ROOTS+=("$2")
				EXTRA_UPPERS+=("")
				EXTRA_WORKS+=("")
				EXTRA_LAYER_ROOTS+=("")
				shift 2
				;;
			--extra-upper)
				[[ $# -ge 2 ]] || die_usage "--extra-upper requires a directory"
				(( ${#EXTRA_ROOTS[@]} > 0 )) || die_usage "--extra-upper must follow an --extra-root"
				EXTRA_UPPERS[$(( ${#EXTRA_ROOTS[@]} - 1 ))]=$2
				shift 2
				;;
			--extra-work)
				[[ $# -ge 2 ]] || die_usage "--extra-work requires a directory"
				(( ${#EXTRA_ROOTS[@]} > 0 )) || die_usage "--extra-work must follow an --extra-root"
				EXTRA_WORKS[$(( ${#EXTRA_ROOTS[@]} - 1 ))]=$2
				shift 2
				;;
			--help|-h)
				usage
				exit 0
				;;
			--)
				shift
				CMD=("$@")
				break
				;;
			-*)
				die_usage "unknown option: $1"
				;;
			*)
				die_usage "unexpected argument: $1 (options must precede --)"
				;;
		esac
	done
}

cmd_run() {
	parse_run_args "$@"
	if [[ -n "$UPPER" && -n "$WORK" ]]; then
		cmd_run_direct
	elif [[ -n "$TURN_ID" && -n "$MODE" && -n "$ANSWER_OUT" ]]; then
		cmd_run_yanad
	else
		die_usage "--workspace, --turn, --mode and --answer-out are required"
	fi
}

main() {
	case "${1:-}" in
		review-abort)
			shift
			parse_yanad_admin_args "$@"
			yanad_admin_command review.abort "$SESSION_ID" "$FORCE_REASON"
			exit $?
			;;
		session-delete)
			shift
			parse_yanad_admin_args "$@"
			[[ -n "$FORCE_REASON" ]] || die_usage "session-delete requires --reason"
			yanad_admin_command session.delete "$SESSION_ID" "$FORCE_REASON"
			exit $?
			;;
		release|force-release|sweep)
			die_usage "legacy '$1' retired; use review-abort --session ID or session-delete --session ID --reason TEXT"
			;;
		""|-h|--help|help)
			usage
			exit 0
			;;
		*)
			cmd_run "$@"
			;;
	esac
}

main "$@"
