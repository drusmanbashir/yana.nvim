#!/usr/bin/env bash
# yana-turn — one headless turn: preflight + confined agent + change set + apply.
#
# CORE, "No whole-repository work": there is no snapshot copy and no manifest
# pass. The overlay's lower layer is the before-picture and its upper layer is
# the change set, so a turn costs what the agent touched and nothing more.
set -euo pipefail

readonly EXIT_USAGE=64
readonly EXIT_REFUSE=65
readonly EXIT_NO_SANDBOX=66
readonly EXIT_SELF_CHECK=67

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$DIR/.." && pwd)"
SANDBOX="$DIR/yana-sandbox"
APPLY="$DIR/yana-apply"
OVERLAY="$DIR/yana-overlay"
TURN_LUA="$REPO/lua/yana/cli/turn.lua"
NVIM="${YANA_TURN_NVIM:-${YANA_APPLY_NVIM:-nvim}}"

# State-root precedence, mirrored byte-compatibly in lua/yana/shadow/preview.lua's
# M.state_root(): YANA_STATE_ROOT, then XDG_STATE_HOME/yana, then
# $HOME/.local/state/yana. A host with a writable XDG_STATE_HOME but a
# read-only/minimal $HOME must land the CLI and the editor on the SAME
# directory, or a claim taken by one is invisible to the other.
STATE_ROOT="${YANA_STATE_ROOT:-${XDG_STATE_HOME:+$XDG_STATE_HOME/yana}}"
STATE_ROOT="${STATE_ROOT:-$HOME/.local/state/yana}"
WORKSPACE=""
PROMPT=""
DIARY=""
STREAM="default"
TURN_ID=""
CHANGES_OUT=""
MODE="preview"
JSON=0
NO_CLAIM=0
NO_CLAIM_REASON=""
PRINT_STATE_ROOT=0
AGENT=()

usage() {
	cat <<'EOF'
Usage: yana-turn --workspace DIR --prompt TEXT
                     [--state-root DIR] [--diary DIR] [--stream NAME]
                     [--turn-id ID] [--preview | --accept]
                     [--changes-out DIR] [--agent CMD...] [--json]
                     [--no-claim-reason TEXT]
       yana-turn --print-state-root
                     (resolve and print the default state root, then exit —
                     precedence: YANA_STATE_ROOT, XDG_STATE_HOME/yana,
                     $HOME/.local/state/yana)

Runs one confined agent turn and reads the typed change set straight from the
overlay upper layer. Nothing is copied at turn start.
The real workspace is written only by yana-apply on --accept.
One live overlay turn per workspace is enforced via claim unless --no-claim-reason.

Agent binary resolution (no path or username is ever baked in): --agent
overrides outright; otherwise the YANA_AGENT_BIN environment variable is
read, falling back to "cursor-agent" resolved on PATH. Mirrors
lua/yana/config.lua's M.resolve_cmd() precedence for the Neovim plugin.
EOF
}

die_usage() {
	echo "yana-turn: $*" >&2
	echo "yana-turn: run with --help for usage" >&2
	exit "$EXIT_USAGE"
}

refuse() {
	echo "yana-turn: $*" >&2
	exit "$EXIT_REFUSE"
}

realpath_safe() {
	local target=$1
	if [[ -e "$target" ]]; then
		readlink -f -- "$target"
		return 0
	fi
	realpath -ms -- "$target"
}

path_is_prefix() {
	local parent=$1 child=$2
	[[ "$child" == "$parent" || "$child" == "$parent"/* ]]
}

safe_component() {
	local name=$1 label=$2
	if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
		die_usage "$label must be a single safe path component (allowed: letters, digits, '.', '_', '-'; no '/')"
	fi
}

require_disjoint() {
	local ws=$1 path=$2 label=$3 remedy=${4:-}
	if path_is_prefix "$ws" "$path" || path_is_prefix "$path" "$ws"; then
		refuse "$label ($path) must be disjoint from workspace ($ws)${remedy:+ — $remedy}"
	fi
}

# Reject derived paths whose prefix chain includes a symlink — otherwise mkdir -p
# follows the link and writes into the real workspace before preflight runs.
refuse_symlink_components() {
	local path=$1 label=$2
	if [[ "$path" != /* ]]; then
		die_usage "internal: $label must be an absolute path"
	fi
	local cur="" part rest="${path#/}"
	while [[ -n "$rest" ]]; do
		if [[ "$rest" == */* ]]; then
			part="${rest%%/*}"
			rest="${rest#*/}"
		else
			part="$rest"
			rest=""
		fi
		if [[ -z "$cur" ]]; then
			cur="/$part"
		else
			cur="$cur/$part"
		fi
		if [[ -L "$cur" ]]; then
			refuse "$label: symlink component in derived path: $cur — replace $cur with a real directory, or re-point the flag this path derives from (--state-root, --diary, or --changes-out) at a symlink-free location"
		fi
	done
}

parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--workspace)
				[[ $# -ge 2 ]] || die_usage "--workspace requires a directory"
				WORKSPACE=$2
				shift 2
				;;
			--prompt)
				[[ $# -ge 2 ]] || die_usage "--prompt requires text"
				PROMPT=$2
				shift 2
				;;
			--state-root)
				[[ $# -ge 2 ]] || die_usage "--state-root requires a directory"
				STATE_ROOT=$2
				shift 2
				;;
			--diary)
				[[ $# -ge 2 ]] || die_usage "--diary requires a directory"
				DIARY=$2
				shift 2
				;;
			--stream)
				[[ $# -ge 2 ]] || die_usage "--stream requires a name"
				STREAM=$2
				shift 2
				;;
			--turn-id)
				[[ $# -ge 2 ]] || die_usage "--turn-id requires an id"
				TURN_ID=$2
				shift 2
				;;
			--changes-out)
				[[ $# -ge 2 ]] || die_usage "--changes-out requires a directory"
				CHANGES_OUT=$2
				shift 2
				;;
			--agent)
				shift
				if [[ $# -eq 0 ]]; then
					die_usage "--agent requires a command"
				fi
				AGENT=("$@")
				break
				;;
			--preview)
				MODE="preview"
				shift
				;;
			--accept)
				MODE="accept"
				shift
				;;
			--json)
				JSON=1
				shift
				;;
			--no-claim-reason)
				[[ $# -ge 2 ]] || die_usage "--no-claim-reason requires text"
				NO_CLAIM=1
				NO_CLAIM_REASON=$2
				shift 2
				;;
			--print-state-root)
				PRINT_STATE_ROOT=1
				shift
				;;
			--help|-h)
				usage
				exit 0
				;;
			-*)
				die_usage "unknown option: $1"
				;;
			*)
				die_usage "unexpected argument: $1"
				;;
		esac
	done
}

yanad_cli_session_create() {
	local args_json response rc
	args_json=$(python3 - "$WORKSPACE" <<'PY'
import json
import sys
print(json.dumps({"workspace": sys.argv[1], "backend": "cli", "kind": "cli"}, separators=(",", ":")))
PY
)
	if response=$(PYTHONPATH="$DIR/lib" python3 -m yanad.client --root "$STATE_ROOT" \
		--owner-pid "$$" --id "$TURN_ID:session.create" --kind cli \
		session.create --json "$args_json"); then
		rc=0
	else
		rc=$?
	fi
	(( rc == 0 )) || return "$rc"
	SESSION_ID=$(python3 - "$response" <<'PY'
import json
import sys
result = json.loads(sys.argv[1])["result"]
print(result.get("session_id") or result["session"]["session_id"])
PY
)
}

main_yanad() {
	WORKSPACE=$(realpath_safe "$WORKSPACE")
	STATE_ROOT=$(realpath_safe "$STATE_ROOT")
	safe_component "$STREAM" "--stream"
	TURN_ID="${TURN_ID:-$(date +%s%N)-$$}"
	safe_component "$TURN_ID" "--turn-id"
	if [[ -z "$DIARY" ]]; then
		DIARY="$STATE_ROOT/diary"
	fi
	DIARY=$(realpath_safe "$DIARY")

	local preflight_root private preflight_err preflight_rc preflight_msg cleanup_command
	preflight_root="$STATE_ROOT/run/yanad-preflight-$TURN_ID-$$"
	private="$preflight_root/private"
	require_disjoint "$WORKSPACE" "$STATE_ROOT" "--state root" \
		"pass --state-root DIR (or set YANA_STATE_ROOT) naming a directory outside the workspace"
	require_disjoint "$WORKSPACE" "$DIARY" "--diary root" \
		"pass --diary DIR naming a directory outside the workspace"
	if [[ -n "$CHANGES_OUT" ]]; then
		CHANGES_OUT=$(realpath_safe "$CHANGES_OUT")
		require_disjoint "$WORKSPACE" "$CHANGES_OUT" "--changes-out" \
			"pass --changes-out DIR naming a directory outside the workspace"
		refuse_symlink_components "$CHANGES_OUT" "changes-out path"
	fi
	refuse_symlink_components "$preflight_root" "preflight state path"
	mkdir -p "$private"
	printf -v cleanup_command 'rm -rf -- %q' "$preflight_root"
	trap "$cleanup_command" EXIT

	preflight_err="$preflight_root/stderr"
	set +e
	"$SANDBOX" --preflight-only --workspace "$WORKSPACE" --shadow "$private" \
		--state-root "$STATE_ROOT" 2>"$preflight_err"
	preflight_rc=$?
	set -e
	[[ ! -s "$preflight_err" ]] || cat "$preflight_err" >&2
	preflight_msg=""
	[[ ! -s "$preflight_err" ]] || preflight_msg=$(tail -n 1 "$preflight_err")
	if (( preflight_rc == EXIT_REFUSE || preflight_rc == EXIT_NO_SANDBOX || preflight_rc == EXIT_SELF_CHECK )); then
		echo "yana-turn: sandbox preflight refused (exit $preflight_rc)${preflight_msg:+ — $preflight_msg}" >&2
		exit "$preflight_rc"
	fi
	if (( preflight_rc != 0 )); then
		echo "yana-turn: sandbox preflight failed (exit $preflight_rc)${preflight_msg:+ — $preflight_msg}" >&2
		exit "$preflight_rc"
	fi

	local session_rc
	set +e
	yanad_cli_session_create
	session_rc=$?
	set -e
	(( session_rc == 0 )) || exit "$session_rc"

	local answer_file="$preflight_root/answer.json"
	local -a agent_cmd=() ovl_args=(
		--workspace "$WORKSPACE"
		--session "$SESSION_ID"
		--turn "$TURN_ID"
		--mode "$MODE"
		--answer-out "$answer_file"
	)
	if (( ${#AGENT[@]} > 0 )); then
		agent_cmd=("${AGENT[@]}")
	else
		agent_cmd=("${YANA_AGENT_BIN:-cursor-agent}" -p "$PROMPT" --trust --force)
	fi
	set +e
	"$OVERLAY" "${ovl_args[@]}" -- sh -c 'cd "$1" && shift && exec "$@"' \
		_ "$WORKSPACE" "${agent_cmd[@]}"
	local agent_rc=$?
	set -e
	if (( agent_rc == EXIT_NO_SANDBOX || agent_rc == EXIT_SELF_CHECK )); then
		echo "yana-turn: overlay launch failed (exit $agent_rc)" >&2
		exit "$agent_rc"
	fi
	if (( agent_rc == EXIT_REFUSE )); then
		echo "yana-turn: overlay refused (exit $agent_rc)" >&2
		exit "$agent_rc"
	fi
	if (( agent_rc != 0 )); then
		echo "yana-turn: agent exited $agent_rc" >&2
		exit "$agent_rc"
	fi

	local -a launch_paths=()
	mapfile -d '' -t launch_paths < <(python3 - "$answer_file" <<'PY'
import json
import os
import sys
launch = json.load(open(sys.argv[1], encoding="utf-8"))["launch"]
values = [launch["turn_dir"], os.path.join(launch["layers"]["workspace"], "upper")]
sys.stdout.buffer.write(b"\0".join(os.fsencode(value) for value in values) + b"\0")
PY
	)
	(( ${#launch_paths[@]} == 2 )) || exit "$EXIT_SELF_CHECK"
	local turn_dir=${launch_paths[0]} upper=${launch_paths[1]} turn_diary
	if [[ -z "$CHANGES_OUT" ]]; then
		CHANGES_OUT="$turn_dir/changes"
	fi
	turn_diary="$DIARY/$STREAM/$TURN_ID"
	mkdir -p "$CHANGES_OUT"

	local finish_args=(finish --workspace "$WORKSPACE" --upper "$upper" --changes-out "$CHANGES_OUT")
	(( JSON == 0 )) || finish_args+=(--json)
	"$NVIM" --clean -l "$TURN_LUA" "${finish_args[@]}"
	if [[ "$MODE" == "preview" ]]; then
		echo "yana-turn: review open — this preview is held by session $SESSION_ID (turn $TURN_ID)" >&2
		exit 0
	fi
	"$NVIM" --clean -l "$TURN_LUA" check-deletes --workspace "$WORKSPACE" --upper "$upper"
	mkdir -p "$turn_diary"
	"$APPLY" apply --changes "$CHANGES_OUT" --target "$WORKSPACE" --diary "$turn_diary" --stream "$STREAM"
}

main() {
	parse_args "$@"
	# Print the resolved state root and exit, before the --workspace/--prompt
	# requirement below — a parity check against the Lua resolver has neither.
	if (( PRINT_STATE_ROOT == 1 )); then
		printf '%s\n' "$(realpath_safe "$STATE_ROOT")"
		exit 0
	fi
	[[ -n "$WORKSPACE" && -n "$PROMPT" ]] || die_usage "--workspace and --prompt are required"
	main_yanad
	return
}

main "$@"
