#!/usr/bin/env python3
"""Exercise MCP through the generated Claude configuration in an installed tree."""
import json
import os
from pathlib import Path
import subprocess
import sys

args = sys.argv[1:]
if "--list-models" in args:
    print("Available models\n\nauto - Auto (current)")
    raise SystemExit(0)
target = os.environ.get("YANA_TURN_SMOKE_TARGET", "notes.txt")
if "--mcp-config" in args:
    assert "--restricted" in args and "--strict-mcp-config" in args
    assert args[args.index("--tools") + 1] == ""
    assert Path.cwd() == Path(os.environ["YANA_STATE_ROOT"]) / "mcp-agent"
    assert not Path(target).exists()
    config = json.loads(Path(args[args.index("--mcp-config") + 1]).read_text())
    server = config["mcpServers"]["yana"]
    with subprocess.Popen([server["command"], *server["args"]], cwd=server["cwd"],
                          env={**os.environ, **server["env"]}, stdin=subprocess.PIPE,
                          stdout=subprocess.PIPE, text=True) as process:
        def call(number, method, params):
            process.stdin.write(json.dumps({"jsonrpc": "2.0", "id": number,
                                            "method": method, "params": params}) + "\n")
            process.stdin.flush()
            response = json.loads(process.stdout.readline())
            result = response["result"]
            assert not result.get("isError"), result
            return result

        call(1, "initialize", {"protocolVersion": "2025-11-25", "capabilities": {},
                               "clientInfo": {"name": "release-smoke", "version": "1"}})
        if server["env"].get("YANA_MCP_MODE") == "ask":
            call(2, "tools/call", {"name": "read", "arguments": {"name": target}})
        else:
            result = call(2, "tools/call", {"name": "open_buffer", "arguments": {"name": target}})
            opened = json.loads(result["content"][0]["text"])
            call(3, "tools/call", {"name": "edit_buffer", "arguments": {
                "buffer_ref": opened["buffer_ref"], "after_text": opened["text"] + "turn smoke edit\n"}})
        process.stdin.close()
        if process.wait(timeout=5):
            raise SystemExit("MCP server failed")
else:
    raise SystemExit("missing Claude MCP configuration")
session = "yana-turn-smoke"
print(json.dumps({"type": "system", "subtype": "init", "session_id": session, "model": "Auto"}))
print(json.dumps({"type": "result", "subtype": "success", "is_error": False,
                  "result": "turn smoke edit", "session_id": session}))
